# Явное переключение: gemini (прежний путь) или openrouter.
LLM_BACKEND=gemini
# Нужен для openrouter: GPT-OSS 120B/Cerebras и предварительный Exa Instant. Маршрут закреплён в lib/openrouter.js.
OPENROUTER_API_KEY=
# Следующие ключи используются только в режиме gemini.
GEMINI_API_KEY=
SERPER_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000

# Optional persistent conversation history; see docs/SUPABASE_SETUP.md
MEMORY_BACKEND=session
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
